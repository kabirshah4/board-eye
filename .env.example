# How the board is read. Leave unset for local image processing: free, offline, ~5 ms.
# BOARD_READER=jev reads the opponent's moves with Jev instead (needs paid AI Gateway credits).
# BOARD_READER=jev
JEV_API_KEY=
# Which image shape Jev takes; scripts/probe_jev.py tells you.
JEV_IMAGE_FORMAT=blocks
# How sure Jev must be before a move is spoken (0-1).
MIN_CONFIDENCE=0.8
# Leave unset: a Vercel AI Gateway key (vck_...) goes through the gateway, others to TypeSafe.
# JEV_BASE_URL=
